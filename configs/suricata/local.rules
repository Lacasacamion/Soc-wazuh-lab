# Reglas locales del laboratorio - Trafico interno (Este-Oeste)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"LAB - Posible escaneo SYN interno"; flags:S; threshold: type threshold, track by_src, count 15, seconds 5; sid:9000001; rev:1;)
alert icmp $HOME_NET any -> $HOME_NET any (msg:"LAB - Ping ICMP interno detectado"; itype:8; sid:9000002; rev:1;)
